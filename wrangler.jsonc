{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iq-test",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "unlocked-iq.shubhammathur.in", "custom_domain": true },
    { "pattern": "iq-test.shubhammathur.in", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iq-test",
      "database_id": "23555869-21e5-4c0e-a431-9321e714d0e2",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_WRITE", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    { "name": "RL_EVENTS", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
